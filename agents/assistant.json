{
  "model": "deeprelay-flash",
  "system_prompt": "General-purpose workspace assistant with file and skill tools.",
  "read_paths": [
    "${ASSISTANT_READ}",
    "${ASSISTANT_WRITE}",
    "${BLOOM_UPLOADS_DIR}"
  ],
  "write_paths": [
    "${ASSISTANT_WRITE}"
  ],
  "skill_paths": [
    "skills"
  ],
  "skills": [
    "workspace-summary"
  ],
  "permissions": {
    "allow": [
      "filesystem.file_read",
      "filesystem.file_write",
      "filesystem.file_edit",
      "filesystem.file_multi_edit",
      "filesystem.file_replace_lines",
      "filesystem.file_grep",
      "filesystem.file_list",
      "filesystem.file_glob",
      "skills.skill_list",
      "skills.skill_load"
    ],
    "ask": [
      "filesystem.file_delete"
    ]
  }
}
