# Model API key referenced by bloom/models.json
DEEPRELAY_API_KEY="your-api-key-here"

# Agent-scoped workspace directories referenced by agents/assistant.json
ASSISTANT_READ="workspace/read/"
ASSISTANT_WRITE="workspace/write/"

# Runtime storage directories (sessions/<agent>/ and uploaded files)
BLOOM_SESSIONS_DIR="sessions/"
BLOOM_UPLOADS_DIR="uploads/"
